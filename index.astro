---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profile } from "../../data/resume.ts";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout
  title={`Writing — ${profile.name}`}
  description={`Commentary and responses on multi-family marketing by ${profile.name}.`}
>
  <section class="hero container" style="padding-bottom: 1.5rem;">
    <span class="eyebrow reveal d1">Writing</span>
    <h1 class="display reveal d2" style="font-size: clamp(2.4rem, 6vw, 4rem); max-width: 16ch;">
      Notes from the industry.
    </h1>
    <p class="hero-sub reveal d3">
      Responses to what I'm reading across multi-family marketing, leasing, and proptech —
      and the takeaways I'm putting to work.
    </p>
  </section>

  <section class="section container" style="padding-top: 1rem;">
    {posts.length === 0 ? (
      <p>First post coming soon.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-item">
            <a href={`/writing/${post.id}/`}>
              <span class="post-date">{fmt(post.data.pubDate)}</span>
              <h3>{post.data.title}</h3>
              <p class="post-dek">{post.data.description}</p>
              {post.data.sourceTitle && (
                <p class="post-source">
                  In response to “{post.data.sourceTitle}”
                  {post.data.sourcePublication && ` · ${post.data.sourcePublication}`}
                </p>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
